*.exe
*.o
*.obj
*.ini

# User-picked custom logo (see browse_and_set_logo() in main.c) -
# copied here at runtime, same portable/no-installer reasoning as the
# .ini above, not something to ship a default value for.
branding.bmp

# Custom app icon override (see branding/README.md and
# load_branding_icon() in main.c) - same portable/no-default reasoning
# as branding.bmp above, just its own dedicated folder instead of a
# loose file, so it reads as "drop your icon here".
branding/icon.ico

# Transit.dll is a proprietary vendor DLL, never committed - same rule
# sdr_app's .gitignore follows for it.
dll/

# Generated by tools/obfuscate.py for a "protected" (string-hidden)
# release build - scratch output, not source. Regenerate + reapply the
# small set of by-hand array conversions (see the script's own comment)
# rather than committing this.
build_obf/
