#include "resource.h"
#include <winuser.h>

IDI_APP_ICON ICON "app.ico"

/* An application manifest, not just an icon, and a full VERSIONINFO
 * block below (Company/Product/Description/Version) - a completely
 * bare, stripped, unsigned exe with zero of this metadata is exactly
 * the profile Defender/AV heuristics flag as suspicious for a new,
 * frequently-changing file. Neither of these makes the exe "trusted"
 * on their own (there's no substitute for actually code-signing it),
 * but a real publisher/product identity and no missing manifest
 * meaningfully cuts down heuristic false positives compared to a file
 * that looks like it's deliberately hiding everything about itself. */
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "lankipolo123"
            VALUE "FileDescription", "ECM Controller"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "digital_noise_config_multi"
            VALUE "LegalCopyright", "lankipolo123"
            VALUE "OriginalFilename", "digital_noise_config_multi.exe"
            VALUE "ProductName", "ECM Controller"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* WM_CLOSE's confirmation dialog - direct request for explicit choices
 * instead of a plain OK/Cancel MessageBoxA. The 1st/default button
 * (IDOK, DEFPUSHBUTTON so Enter activates it) turns everything off;
 * the 2nd (custom ID) leaves channels running as they currently are;
 * the 3rd (IDCANCEL) stays open. See close_confirm_dlg_proc() in
 * main.c. DS_CENTER centers it the same way IDD_CW_PASSWORD used to.
 * Plain native (non-owner-drawn) buttons and default dialog background
 * are intentional, not an oversight - direct correction, matching this
 * app's own established precedent for occasional secondary windows
 * (see log_view_wnd_proc()'s own comment) rather than a themed custom
 * paint job. */
IDD_CLOSE_CONFIRM DIALOGEX 0, 0, 260, 104
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Terminate ECM Controller"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Every channel's state will be saved either way. Choose what happens to them before the app closes:", -1, 7, 7, 246, 26
    DEFPUSHBUTTON   "Turn Off and Close", IDOK, 7, 40, 246, 16
    PUSHBUTTON      "Keep Running and Close", IDC_CLOSE_KEEP_RUNNING_BTN, 7, 60, 246, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 7, 82, 246, 16
END
