<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="DigitalNoiseConfigMulti.App"
    version="1.0.0.0"
    processorArchitecture="*"
  />
  <description>Digital Noise Configuration - Multi</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- System DPI-aware: without this, Windows treats the process as
       DPI-unaware and virtualizes everything - SPI_GETWORKAREA (used at
       startup in main.c to size/relayout the maximized window) reports a
       scaled-down virtual work area instead of the real screen's pixels
       (e.g. ~1536x864 instead of 1920x1080 at 125% scaling), so the
       fixed-pixel layout gets squeezed to fit that smaller virtual canvas
       and DWM then bitmap-stretches the whole rendered window back up to
       the real screen size - blurry text, undersized/cramped controls,
       nothing lining up with the sizes actually designed in main.c. This
       app's layout is fixed-pixel (not DPI-scaled at runtime), so System
       (not Per-Monitor) is correct - it renders at native pixel size
       once, matching what a normal unscaled 1920x1080 display would show,
       instead of needing WM_DPICHANGED handling for monitors changing
       mid-session. -->
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <dpiAware>true</dpiAware>
    </asmv3:windowsSettings>
  </asmv3:application>
  <!-- Deliberately NOT declaring the Common-Controls v6 dependency here.
       That switches every control to Windows' themed (visual-styles)
       rendering, drawn directly by uxtheme.dll - including a native
       hover/hot-track highlight on combo boxes that bypasses this
       app's WM_CTLCOLORSTATIC-based dark theming entirely (confirmed:
       a white hover highlight showing through on the Port combos was
       traced back to this). Every control in this app is already
       manually owner-drawn or re-themed by hand, so v6 gives nothing
       here but that regression - staying on the classic (v5, unthemed)
       common controls is the correct choice for this app specifically,
       not an oversight. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 through 11 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>
</assembly>
