<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="DigitalNoiseConfigMulti.App"
    version="1.0.0.0"
    processorArchitecture="*"
  />
  <description>Digital Noise Configuration - Multi</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Deliberately NOT declaring the Common-Controls v6 dependency here.
       That switches every control to Windows' themed (visual-styles)
       rendering, drawn directly by uxtheme.dll - including a native
       hover/hot-track highlight on combo boxes that bypasses this
       app's WM_CTLCOLORSTATIC-based dark theming entirely (confirmed:
       a white hover highlight showing through on the Port combos was
       traced back to this). Every control in this app is already
       manually owner-drawn or re-themed by hand, so v6 gives nothing
       here but that regression - staying on the classic (v5, unthemed)
       common controls is the correct choice for this app specifically,
       not an oversight. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 through 11 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>
</assembly>
